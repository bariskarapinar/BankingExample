<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="6dp"
    app:strokeWidth="1dp"
    app:strokeColor="#334155"
    android:layout_marginBottom="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172A"
        android:padding="16dp">

        <!-- Bank / Scheme Label -->
        <TextView
            android:id="@+id/tvCardBankName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMV BANK GLOBAL"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <ImageView
            android:id="@+id/ivContactless"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/ic_contactless_wave"
            app:tint="#38BDF8" />

        <!-- Gold EMV Chip -->
        <ImageView
            android:id="@+id/ivEmvChip"
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:layout_below="@id/tvCardBankName"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_gold_chip" />

        <TextView
            android:id="@+id/tvCardScheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/ivContactless"
            android:layout_marginTop="16dp"
            android:text="VISA"
            android:textColor="#38BDF8"
            android:textSize="18sp"
            android:textStyle="bold|italic" />

        <!-- Card Number -->
        <TextView
            android:id="@+id/tvCardNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/ivEmvChip"
            android:layout_marginTop="14dp"
            android:text="4543  1234  5678  9012"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

        <!-- Cardholder Name & Expiry -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CARDHOLDER"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvCardHolderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AHMET YILMAZ"
                    android:textColor="#F8FAFC"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EXPIRES"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvCardExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12/28"
                    android:textColor="#F8FAFC"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="#2563EB"
    android:layout_marginBottom="12dp">

    <RelativeLayout
        android:id="@+id/cardContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card_visa"
        android:padding="16dp">

        <!-- Bank / Scheme Label -->
        <TextView
            android:id="@+id/tvCardBankName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMV BANK GLOBAL"
            android:textColor="#93C5FD"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <!-- Gold EMV Chip -->
        <ImageView
            android:id="@+id/ivEmvChip"
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:layout_below="@id/tvCardBankName"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_gold_chip" />

        <!-- Clean Dynamic Scheme Logo (Only for Visa & Mastercard; Gone for Troy & Amex) -->
        <ImageView
            android:id="@+id/ivCardLogo"
            android:layout_width="64dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginTop="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_visa_logo" />

        <!-- Card Number -->
        <TextView
            android:id="@+id/tvCardNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/ivEmvChip"
            android:layout_marginTop="14dp"
            android:text="4543  1234  5678  9012"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

        <!-- Cardholder Name & Expiry -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CARDHOLDER"
                    android:textColor="#93C5FD"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvCardHolderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JOHN DOE"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EXPIRES"
                    android:textColor="#93C5FD"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/tvCardExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12/28"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>

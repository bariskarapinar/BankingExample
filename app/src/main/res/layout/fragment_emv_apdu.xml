<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#FAFAFA">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/card_background"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider_color"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ISO 7816 / EMV APDU Command Simulator"
                android:textColor="#2563EB"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spApduPresets"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_param_box"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp" />

            <!-- APDU Header Parameters (CLA, INS, P1, P2) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_param_box"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CLA"
                        android:textColor="#2563EB"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etCla"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:text="00"
                        android:textColor="#2563EB"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:inputType="textCapCharacters" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_param_box"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INS"
                        android:textColor="#2563EB"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etIns"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:text="A4"
                        android:textColor="#2563EB"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:inputType="textCapCharacters" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_param_box"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="P1"
                        android:textColor="#2563EB"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etP1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:text="04"
                        android:textColor="#2563EB"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:inputType="textCapCharacters" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_param_box"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="P2"
                        android:textColor="#2563EB"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etP2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:text="00"
                        android:textColor="#2563EB"
                        android:fontFamily="monospace"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:inputType="textCapCharacters" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxStrokeColor="#2563EB"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etApduData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Data Bytes (Hex)"
                    android:text="31325041592E5359532E4444463031"
                    android:textColor="#09090B"
                    android:textColorHint="#71717A"
                    android:fontFamily="monospace"
                    android:textSize="11sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendApdu"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                app:cornerRadius="8dp"
                android:text="EXECUTE APDU COMMAND"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:backgroundTint="@color/accent" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/card_background"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider_color">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp"
            android:background="#EFF6FF">

            <TextView
                android:id="@+id/tvApduResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="#2563EB"
                android:text="APDU execution result log will appear here." />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>

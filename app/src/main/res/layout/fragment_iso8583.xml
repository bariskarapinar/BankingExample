<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#FAFAFA">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/card_background"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider_color"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ISO 8583 Message Packer &amp; Inspector"
                android:textColor="@color/primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spIsoPresets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etIsoHex"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="ISO 8583 Hex Stream"
                    android:textColor="#09090B"
                    android:textColorHint="#71717A"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:lines="2"
                    android:gravity="top|start" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUnpackIso"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    app:cornerRadius="8dp"
                    android:text="UNPACK MESSAGE"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMtiInfo"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    app:cornerRadius="8dp"
                    android:text="Bitmap Grid"
                    android:textSize="11sp"
                    app:strokeColor="#2563EB"
                    android:textColor="#2563EB" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnalyzeField55"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    app:cornerRadius="8dp"
                    android:text="Field 55 TLVs"
                    android:textSize="11sp"
                    app:strokeColor="#2563EB"
                    android:textColor="#2563EB" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFieldLookupTool"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    app:cornerRadius="8dp"
                    android:text="Field Catalog"
                    android:textSize="11sp"
                    app:strokeColor="#2563EB"
                    android:textColor="#2563EB" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvIsoHeaderSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/code_background"
        android:textColor="@color/code_text"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:padding="8dp"
        android:layout_marginBottom="6dp"
        android:text="MTI: 0200 | Primary Bitmap: 703C058028C08000" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvIsoFields"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

</LinearLayout>

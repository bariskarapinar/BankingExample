<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#FAFAFA">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/card_background"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider_color"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ISO 8583 Engine"
                    android:textColor="#2563EB"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUnpackIso"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    app:cornerRadius="8dp"
                    android:text="UNPACK MESSAGE"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    app:backgroundTint="@color/accent" />
            </LinearLayout>

            <Spinner
                android:id="@+id/spIsoPresets"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_param_box"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_marginBottom="6dp" />

            <!-- Custom Royal Blue ISO 8583 Hex Stream Input Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_param_box"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ISO 8583 HEX STREAM"
                    android:textColor="#2563EB"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <EditText
                    android:id="@+id/etIsoHex"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="ISO 8583 Hex Stream..."
                    android:textColor="#2563EB"
                    android:textColorHint="#93C5FD"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:lines="2"
                    android:gravity="top|start" />
            </LinearLayout>

            <!-- Scrollable Tools & Presets Bar -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMtiInfo"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        app:cornerRadius="8dp"
                        android:text="Bitmap Grid"
                        android:textSize="11sp"
                        app:strokeColor="#2563EB"
                        android:textColor="#2563EB" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAnalyzeField55"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        app:cornerRadius="8dp"
                        android:text="Field 55 TLVs"
                        android:textSize="11sp"
                        app:strokeColor="#2563EB"
                        android:textColor="#2563EB" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFieldLookupTool"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        app:cornerRadius="8dp"
                        android:text="Field Catalog"
                        android:textSize="11sp"
                        app:strokeColor="#2563EB"
                        android:textColor="#2563EB" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvIsoHeaderSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EFF6FF"
        android:textColor="#2563EB"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textStyle="bold"
        android:padding="8dp"
        android:layout_marginBottom="6dp"
        android:text="MTI: 0200 | Primary Bitmap: 703C058028C08000" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvIsoFields"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

</LinearLayout>

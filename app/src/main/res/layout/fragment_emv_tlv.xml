<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#FAFAFA">

    <!-- Compact Control Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/card_background"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider_color"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="EMV BER-TLV Decoder"
                    android:textColor="@color/primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnParseTlv"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    app:cornerRadius="8dp"
                    android:text="PARSE TLV"
                    android:textSize="11sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    app:backgroundTint="@color/accent" />
            </LinearLayout>

            <!-- Custom Royal Blue Hex Payload Input Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_param_box"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMV HEX PAYLOAD"
                    android:textColor="#2563EB"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <EditText
                    android:id="@+id/etTlvInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="9F2608A1B2C3D4..."
                    android:textColor="#2563EB"
                    android:textColorHint="#93C5FD"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:lines="2"
                    android:gravity="top|start" />
            </LinearLayout>

            <!-- Scrollable Tools & Presets Bar -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSampleF55"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        app:cornerRadius="8dp"
                        android:text="Field 55"
                        android:textSize="11sp"
                        app:strokeColor="#2563EB"
                        android:textColor="#2563EB" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSampleFci"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        app:cornerRadius="8dp"
                        android:text="FCI"
                        android:textSize="11sp"
                        app:strokeColor="#2563EB"
                        android:textColor="#2563EB" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTagLookupTool"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        app:cornerRadius="8dp"
                        android:text="Tag Catalog"
                        android:textSize="11sp"
                        app:strokeColor="#2563EB"
                        android:textColor="#2563EB" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPinBlockTool"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        app:cornerRadius="8dp"
                        android:text="PIN Block"
                        android:textSize="11sp"
                        app:strokeColor="#2563EB"
                        android:textColor="#2563EB" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTvrEditorTool"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        app:cornerRadius="8dp"
                        android:text="TVR (Tag 95)"
                        android:textSize="11sp"
                        app:strokeColor="#2563EB"
                        android:textColor="#2563EB" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnArqcCalcTool"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        app:cornerRadius="8dp"
                        android:text="ARQC Demo"
                        android:textSize="11sp"
                        app:strokeColor="#2563EB"
                        android:textColor="#2563EB" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvParsedCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Parsed Elements Count:"
        android:textColor="@color/primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginStart="2dp"
        android:layout_marginBottom="4dp" />

    <!-- Expanded RecyclerView filling all remaining vertical screen space -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTlvTree"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

</LinearLayout>

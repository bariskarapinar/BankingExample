<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ISO 8583 FIELD CATALOG &amp; SEARCH"
        android:gravity="center"
        android:textColor="#2563EB"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:textStyle="bold" />

    <!-- Royal Blue Search Input Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_param_box"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEARCH FIELD OR KEYWORD"
            android:textColor="#2563EB"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <EditText
            android:id="@+id/etFieldSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="Search Field (e.g. 55, PAN, STAN...)"
            android:textColor="#2563EB"
            android:textColorHint="#93C5FD"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="#EFF6FF"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvFieldLookupResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#09090B"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>

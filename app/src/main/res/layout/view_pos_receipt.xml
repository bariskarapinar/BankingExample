<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeColor="#E4E4E7"
    app:strokeWidth="1dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="*** CUSTOMER COPY ***"
            android:gravity="center"
            android:textColor="#09090B"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EMV POS MERCHANTS GLOBAL"
            android:gravity="center"
            android:textColor="#09090B"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NEW YORK / UNITED STATES"
            android:gravity="center"
            android:textColor="#71717A"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="------------------------------------------------"
            android:textColor="#E4E4E7"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TID: POS85831"
                android:textColor="#09090B"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MID: MCH858300000001"
                android:textColor="#09090B"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvReceiptDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DATE/TIME: 26/09/2026 14:20:10"
            android:textColor="#09090B"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvReceiptPan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CARD NO: 4543 **** **** 9012 (C)"
            android:textColor="#09090B"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvReceiptAid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AID: A0000000031010 (VISA CREDIT)"
            android:textColor="#71717A"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="------------------------------------------------"
            android:textColor="#E4E4E7"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TOTAL AMOUNT:"
                android:textColor="#09090B"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReceiptAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$250.00"
                android:textColor="#09090B"
                android:textSize="15sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvReceiptAuthCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AUTH CODE: 681042"
            android:textColor="#16A34A"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvReceiptArc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RESPONSE (ARC): 00 (TRANSACTION APPROVED)"
            android:textColor="#16A34A"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="================================================"
            android:textColor="#E4E4E7"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THANK YOU FOR YOUR PAYMENT"
            android:gravity="center"
            android:textColor="#71717A"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

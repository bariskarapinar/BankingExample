<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/code_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ISO 8583 DİNAMİK BITMAP MATRİSİ"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBitmapMatrixHex"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/code_text"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:text="Hex: F238848108E00000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="320dp">

        <TextView
            android:id="@+id/tvBitmapMatrixDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:padding="8dp" />
    </ScrollView>

</LinearLayout>

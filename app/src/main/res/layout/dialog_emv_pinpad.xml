<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="POS TERMINAL PIN PAD"
        android:gravity="center"
        android:textColor="#09090B"
        android:textSize="15sp"
        android:fontFamily="monospace"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PLEASE ENTER CARD PIN"
        android:gravity="center"
        android:textColor="#71717A"
        android:textSize="11sp"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace" />

    <!-- Masked PIN Display -->
    <TextView
        android:id="@+id/tvPinDisplay"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#F4F4F5"
        android:gravity="center"
        android:textColor="#09090B"
        android:textSize="22sp"
        android:letterSpacing="0.4"
        android:fontFamily="monospace"
        android:text="● ● ● ●" />

    <!-- Calculated PIN Block Preview -->
    <TextView
        android:id="@+id/tvCalculatedPinBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#71717A"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:text="ISO-0 PIN Block: 041205DCBA9876FE"
        android:layout_marginBottom="16dp" />

    <!-- Numeric Keypad Grid -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:columnCount="3"
        android:rowCount="4">

        <!-- Row 1 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey1"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="1"
            android:textColor="#09090B"
            android:textSize="18sp"
            app:cornerRadius="10dp"
            app:strokeColor="#E4E4E7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey2"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="2"
            android:textColor="#09090B"
            android:textSize="18sp"
            app:cornerRadius="10dp"
            app:strokeColor="#E4E4E7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey3"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="3"
            android:textColor="#09090B"
            android:textSize="18sp"
            app:cornerRadius="10dp"
            app:strokeColor="#E4E4E7" />

        <!-- Row 2 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey4"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="4"
            android:textColor="#09090B"
            android:textSize="18sp"
            app:cornerRadius="10dp"
            app:strokeColor="#E4E4E7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey5"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="5"
            android:textColor="#09090B"
            android:textSize="18sp"
            app:cornerRadius="10dp"
            app:strokeColor="#E4E4E7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey6"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="6"
            android:textColor="#09090B"
            android:textSize="18sp"
            app:cornerRadius="10dp"
            app:strokeColor="#E4E4E7" />

        <!-- Row 3 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey7"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="7"
            android:textColor="#09090B"
            android:textSize="18sp"
            app:cornerRadius="10dp"
            app:strokeColor="#E4E4E7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey8"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="8"
            android:textColor="#09090B"
            android:textSize="18sp"
            app:cornerRadius="10dp"
            app:strokeColor="#E4E4E7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey9"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="9"
            android:textColor="#09090B"
            android:textSize="18sp"
            app:cornerRadius="10dp"
            app:strokeColor="#E4E4E7" />

        <!-- Row 4 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeyClear"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="C"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:backgroundTint="#D97706" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey0"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="0"
            android:textColor="#09090B"
            android:textSize="18sp"
            app:cornerRadius="10dp"
            app:strokeColor="#E4E4E7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeyEnter"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="OK"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/accent" />
    </GridLayout>

</LinearLayout>

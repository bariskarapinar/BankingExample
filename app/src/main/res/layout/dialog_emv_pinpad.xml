<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/code_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="POS PIN PAD (LÜTFEN PIN GIRINIZ)"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:textStyle="bold" />

    <!-- Masked PIN Display -->
    <TextView
        android:id="@+id/tvPinDisplay"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="#1E293B"
        android:gravity="center"
        android:textColor="@color/code_text"
        android:textSize="22sp"
        android:letterSpacing="0.4"
        android:fontFamily="monospace"
        android:text="● ● ● ●" />

    <!-- Calculated PIN Block Preview -->
    <TextView
        android:id="@+id/tvCalculatedPinBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:text="ISO-0 PIN Block: 041205DCBA9876FE"
        android:layout_marginBottom="16dp" />

    <!-- Numeric Keypad Grid -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:columnCount="3"
        android:rowCount="4">

        <!-- Row 1 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey1"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="1"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:strokeColor="#334155" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey2"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="2"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:strokeColor="#334155" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey3"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="3"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:strokeColor="#334155" />

        <!-- Row 2 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey4"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="4"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:strokeColor="#334155" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey5"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="5"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:strokeColor="#334155" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey6"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="6"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:strokeColor="#334155" />

        <!-- Row 3 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey7"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="7"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:strokeColor="#334155" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey8"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="8"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:strokeColor="#334155" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey9"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="9"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:strokeColor="#334155" />

        <!-- Row 4 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeyClear"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="C"
            android:textSize="16sp"
            app:backgroundTint="#F59E0B" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey0"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:strokeColor="#334155" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeyEnter"
            android:layout_width="70dp"
            android:layout_height="60dp"
            android:layout_margin="4dp"
            android:text="OK"
            android:textSize="14sp"
            app:backgroundTint="#16A34A" />
    </GridLayout>

</LinearLayout>
